# Configurazione Server
PORT=3000
# URL pubblico opzionale usato per i link di condivisione (su Netlify usa automaticamente URL se vuoto)
PUBLIC_BASE_URL=
# Percorso locale per i file JSON (usato su Railway/VPS; su Netlify viene usato Netlify Blobs)
DATA_DIR=

# Chiave segreta per firmare i token di sessione (obbligatoria in produzione/Netlify: almeno 32 caratteri casuali)
# Genera con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Credenziali Unico Account Admin (Proprietario)
ADMIN_EMAIL=carlo@munno.it
ADMIN_PASSWORD=CambiaQuestaPasswordSicura123!
ADMIN_NAME=Carlo Munno Photographer

# Google Drive API v3 (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nINSERISCI_LA_TUA_CHIAVE_PRIVATA\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_ROOT_FOLDER_ID=
