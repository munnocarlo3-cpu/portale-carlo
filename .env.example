# Configurazione Server
PORT=3000
# URL pubblico opzionale usato per generare i link di condivisione (es. https://foto.carlomunno.it)
PUBLIC_BASE_URL=

# Credenziali Unico Account Admin (Proprietario)
ADMIN_EMAIL=carlo@munno.it
ADMIN_PASSWORD=CambiaQuestaPasswordSicura123!
ADMIN_NAME=Carlo Munno Photographer

# Google Drive API v3 (Service Account)
# Email del Service Account creato su Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Chiave privata PEM del Service Account (mantieni i \n sulla stessa riga o usa virgolette)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nINSERISCI_LA_TUA_CHIAVE_PRIVATA\n-----END PRIVATE KEY-----\n"
# ID della cartella radice su Google Drive condivisa con il Service Account
GOOGLE_DRIVE_ROOT_FOLDER_ID=
